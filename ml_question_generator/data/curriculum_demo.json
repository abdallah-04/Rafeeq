    {"curriculum_id":"rafeeq-demo-curriculum-v1","unit_id":"math-l1-count-one","subject":"MATH","level":1,"skill_domain":"Basic Mathematics","topic_ar":"العدد واحد","topic_en":"Number one","learning_objective_ar":"يتعرف العدد واحد.","learning_objective_en":"Recognise the number one.","content_ar":"العدد واحد يعني عنصراً واحداً.","content_en":"The number one means one item.","keywords_ar":["واحد","عدد"],"keywords_en":["one","number"],"prompt_ar":"أي عدد يعني عنصراً واحداً؟","prompt_en":"Which number means one item?","answer_ar":"1","answer_en":"1","distractors_ar":["2","3","4"],"distractors_en":["2","3","4"]},
