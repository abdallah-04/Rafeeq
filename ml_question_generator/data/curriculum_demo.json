    {"curriculum_id":"rafeeq-demo-curriculum-v1","unit_id":"math-l3-subtract","subject":"MATH","level":3,"skill_domain":"Basic Mathematics","topic_ar":"طرح ثلاثة وواحد","topic_en":"Subtract three and one","learning_objective_ar":"يطرح 3 - 1.","learning_objective_en":"Subtract 3 - 1.","content_ar":"عند طرح واحد من ثلاثة يبقى اثنان.","content_en":"When one is taken from three, two remain.","keywords_ar":["طرح","يبقى"],"keywords_en":["subtract","remain"],"prompt_ar":"ما ناتج 3 - 1؟","prompt_en":"What is 3 - 1?","answer_ar":"2","answer_en":"2","distractors_ar":["1","3","4"],"distractors_en":["1","3","4"]},
    {"curriculum_id":"rafeeq-demo-curriculum-v1","unit_id":"math-l3-word-problem","subject":"MATH","level":3,"skill_domain":"Basic Mathematics","topic_ar":"مسألة جمع","topic_en":"Addition word problem","learning_objective_ar":"يحل مسألة جمع قصيرة.","learning_objective_en":"Solve a short addition word problem.","content_ar":"مع سارة تفاحتان وأعطاها والدها تفاحة واحدة، فأصبح معها ثلاث تفاحات.","content_en":"Sara has two apples and receives one more, so she has three apples.","keywords_ar":["تفاح","جمع"],"keywords_en":["apples","addition"],"prompt_ar":"مع سارة تفاحتان وأعطاها والدها تفاحة. كم تفاحة معها الآن؟","prompt_en":"Sara has two apples and gets one more. How many apples does she have now?","answer_ar":"3","answer_en":"3","distractors_ar":["1","2","4"],"distractors_en":["1","2","4"]},
