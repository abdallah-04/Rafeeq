    {"curriculum_id":"rafeeq-demo-curriculum-v1","unit_id":"math-l2-pattern","subject":"MATH","level":2,"skill_domain":"Basic Mathematics","topic_ar":"نمط الأعداد","topic_en":"Number pattern","learning_objective_ar":"يكمل نمطاً بسيطاً.","learning_objective_en":"Complete a simple pattern.","content_ar":"في النمط 1، 2، 3 يأتي العدد 4 بعد 3.","content_en":"In the pattern 1, 2, 3, the number 4 comes after 3.","keywords_ar":["نمط","بعد"],"keywords_en":["pattern","after"],"prompt_ar":"ما العدد التالي: 1، 2، 3، ؟","prompt_en":"What number comes next: 1, 2, 3, ?","answer_ar":"4","answer_en":"4","distractors_ar":["1","2","3"],"distractors_en":["1","2","3"]},
