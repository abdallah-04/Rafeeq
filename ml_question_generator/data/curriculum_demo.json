    {"curriculum_id":"rafeeq-demo-curriculum-v1","unit_id":"lang-l2-category-fruit","subject":"LANGUAGE","level":2,"skill_domain":"Basic Language","topic_ar":"الفاكهة","topic_en":"Fruit category","learning_objective_ar":"يميز كلمة تنتمي إلى الفاكهة.","learning_objective_en":"Identify a word in the fruit category.","content_ar":"التفاح نوع من الفاكهة.","content_en":"An apple is a type of fruit.","keywords_ar":["تفاح","فاكهة"],"keywords_en":["apple","fruit"],"prompt_ar":"أي كلمة هي اسم فاكهة؟","prompt_en":"Which word names a fruit?","answer_ar":"تفاح","answer_en":"Apple","distractors_ar":["قلم","كرسي","باب"],"distractors_en":["Pen","Chair","Door"]},
