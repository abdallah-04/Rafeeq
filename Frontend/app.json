{
  "expo": {
    "name": "Rafeeq",
    "slug": "rafeeq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",

    "scheme": "rafeeq",
    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/images/mascot/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rafeeq.app"
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.rafeeq.app",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c7b6c51-8e1d-4397-83c4-ab12f99696a8"
      }
    },

    "owner": "gumball04"
  }
}