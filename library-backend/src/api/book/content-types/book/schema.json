{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "state": {
      "type": "enumeration",
      "required": true,
      "default": "available",
      "enum": [
        "borrowed",
        "available"
      ]
    },
    "description": {
      "type": "text"
    },
    "rating": {
      "type": "integer"
    },
    "pages": {
      "type": "integer"
    },
    "coverUrl": {
      "type": "string"
    },
    "added_by": {
      "type": "string"
    }
  }
}
